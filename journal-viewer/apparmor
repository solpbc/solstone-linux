# This profile attaches only to the package-owned executable. Ubuntu's
# bubblewrap restrictions and the WebKit renderer's own sandbox remain enabled.
abi <abi/4.0>,
include <tunables/global>
profile solstone-linux-journal /opt/solstone-webkit/bin/journal flags=(attach_disconnected.path=/solstone-detached/,mediate_deleted) {
  userns,
  network,
  unix,
  dbus,
  signal,
  ptrace (read),
  capability net_admin,
  capability setgid,
  capability setuid,
  capability setpcap,
  capability sys_admin,
  capability sys_chroot,
  mount,
  umount,
  pivot_root,
  / r,
  /solstone-detached/{,**} r,
  owner /solstone-detached/run/user/[0-9]*/{bus,webkitgtk/bus-proxy-*,webkitgtk/a11y-proxy-??????,at-spi/**} rw,
  /solstone-detached/{bindfile??????,proc/[0-9]*/{uid_map,gid_map,setgroups}} rw,
  /solstone-detached/{newroot,oldroot}/{,**} rw,
  /solstone-detached/{,**/} rw,
  /{app,dev,proc,sys,tmp,var,run,home,etc,usr,opt,newroot,oldroot,bin,sbin,lib,lib64}/ rw,
  /{app,dev,proc,sys,tmp,var,run,home,etc,usr,opt,newroot,oldroot}/**/ rw,
  /{usr,lib,lib64,bin,sbin,opt/solstone-webkit,etc,proc,sys,dev,tmp,run,newroot,oldroot}/{,**} r,
  owner @{HOME}/** rwkl,
  /{dev,proc,tmp,run/user}/** rwkl,
  /newroot/{,**} rwkl,
  /bindfile?????? rw,
  /var/cache/fontconfig/** rwkl,
  /{usr/lib,usr/lib64,lib,lib64,opt/solstone-webkit/lib,opt/solstone-webkit/fallback}/** mr,
  /opt/solstone-webkit/bin/journal mr,
  /usr/bin/{bwrap,xdg-dbus-proxy} rix,
  /opt/solstone-webkit/libexec/webkitgtk-6.0/{WebKitWebProcess,WebKitNetworkProcess,WebKitGPUProcess} rixm,
}
