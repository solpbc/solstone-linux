<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.solpbc.solstone.Observer1">
      <method name="GetStats">
          <arg direction="out" type="a{sv}" />
        </method>
        <method name="Pause">
          <arg name="duration_seconds" direction="in" type="i" />
            <arg direction="out" type="s" />
        </method>
        <method name="Resume">
          <arg direction="out" type="s" />
        </method>
        <signal name="ErrorOccurred">
          <arg direction="out" type="s" />
        </signal>
        <signal name="StatusChanged">
          <arg direction="out" type="s" />
        </signal>
        <signal name="SyncProgressChanged">
          <arg direction="out" type="s" />
        </signal>
        <property name="CaptureDir" type="s" access="read" />
        <property name="Error" type="s" access="read" />
        <property name="PauseRemaining" type="i" access="read" />
        <property name="SegmentInterval" type="i" access="read" />
        <property name="SegmentTimer" type="i" access="read" />
        <property name="Status" type="s" access="read" />
        <property name="Stream" type="s" access="read" />
        <property name="SyncProgress" type="s" access="read" />
        <property name="SyncStatus" type="s" access="read" />
    </interface>
</node>
