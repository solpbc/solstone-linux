<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="com.canonical.dbusmenu">
      <method name="AboutToShow">
          <arg name="item_id" direction="in" type="i" />
            <arg direction="out" type="b" />
        </method>
        <method name="AboutToShowGroup">
          <arg name="ids" direction="in" type="ai" />
            <arg direction="out" type="ai" />
            <arg direction="out" type="ai" />
        </method>
        <method name="Event">
          <arg name="item_id" direction="in" type="i" />
            <arg name="event_id" direction="in" type="s" />
            <arg name="data" direction="in" type="v" />
            <arg name="timestamp" direction="in" type="u" />
        </method>
        <method name="EventGroup">
          <arg name="events" direction="in" type="a(isvu)" />
            <arg direction="out" type="ai" />
        </method>
        <method name="GetGroupProperties">
          <arg name="ids" direction="in" type="ai" />
            <arg name="property_names" direction="in" type="as" />
            <arg direction="out" type="a(ia{sv})" />
        </method>
        <method name="GetLayout">
          <arg name="parent_id" direction="in" type="i" />
            <arg name="recursion_depth" direction="in" type="i" />
            <arg name="property_names" direction="in" type="as" />
            <arg direction="out" type="u" />
            <arg direction="out" type="(ia{sv}av)" />
        </method>
        <method name="GetProperty">
          <arg name="item_id" direction="in" type="i" />
            <arg name="name" direction="in" type="s" />
            <arg direction="out" type="v" />
        </method>
        <signal name="ItemActivationRequested">
          <arg direction="out" type="i" />
            <arg direction="out" type="u" />
        </signal>
        <signal name="ItemsPropertiesUpdated">
          <arg direction="out" type="a(ia{sv})" />
            <arg direction="out" type="a(ias)" />
        </signal>
        <signal name="LayoutUpdated">
          <arg direction="out" type="u" />
            <arg direction="out" type="i" />
        </signal>
        <property name="IconThemePath" type="as" access="read" />
        <property name="Status" type="s" access="read" />
        <property name="TextDirection" type="s" access="read" />
        <property name="Version" type="u" access="read" />
    </interface>
</node>
